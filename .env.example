# ==============================================================================
# 晶流 LabFlow - 环境变量配置模板 (Production & Development Example)
# 复制此文件为 .env 并根据真实环境配置；.env 已在 .gitignore 中忽略，请勿上传！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础运行环境配置
# ------------------------------------------------------------------------------
PORT=4173
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. 飞书开放平台接入配置 (Feishu Open Platform)
# ------------------------------------------------------------------------------
# 用于获取租户/用户凭证以访问会议转写、多维表格与云文档
FEISHU_APP_ID=cli_xxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 用于接收事件订阅 (Event Subscription) 的安全校验
FEISHU_ENCRYPT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. AI 大模型 API 配置 (Spring AI / LLM Orchestrator)
# ------------------------------------------------------------------------------
# 推荐使用字节跳动火山引擎 (Volcengine Ark) 或 OpenAI / 通义千问等主流大模型服务
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL_NAME=doubao-pro-4k

# ------------------------------------------------------------------------------
# 4. 数据与存储层配置 (Data & Storage)
# ------------------------------------------------------------------------------
# PostgreSQL + pgvector (关系型数据与向量检索)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/labflow?schema=public

# Neo4j 研发知识图谱 (强关系/版本/权限溯源)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password

# Redis (幂等去重 / Checkpoint 状态机 / 缓存)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. 安全与加密密钥 (Security & Session)
# ------------------------------------------------------------------------------
# 用于本地 Session/JWT 加密的 Secret Key
APP_JWT_SECRET=super-secret-jwt-key-change-in-production
