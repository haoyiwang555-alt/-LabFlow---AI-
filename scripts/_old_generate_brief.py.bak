from __future__ import annotations

from pathlib import Path
from reportlab.lib import colors
from reportlab.lib.enums import TA_CENTER, TA_LEFT
from reportlab.lib.pagesizes import A4
from reportlab.lib.styles import ParagraphStyle, getSampleStyleSheet
from reportlab.lib.units import mm
from reportlab.pdfbase.cidfonts import UnicodeCIDFont
from reportlab.pdfbase import pdfmetrics
from reportlab.platypus import (
    BaseDocTemplate, Frame, PageTemplate, Paragraph, Spacer, Table, TableStyle,
    PageBreak, Image, KeepTogether, NextPageTemplate
)

ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / "output" / "晶流LabFlow-开题报告补充材料.pdf"
SCREENSHOT = ROOT / "output" / "screenshots" / "01-dashboard-desktop.png"
pdfmetrics.registerFont(UnicodeCIDFont("STSong-Light"))

INK = colors.HexColor("#10202A")
INK2 = colors.HexColor("#172B35")
PAPER = colors.HexColor("#F5F7F2")
LIME = colors.HexColor("#CBF65D")
MINT = colors.HexColor("#C9F4D9")
MINT_DEEP = colors.HexColor("#2A9E76")
AQUA = colors.HexColor("#7ADBD3")
CORAL = colors.HexColor("#F17969")
VIOLET = colors.HexColor("#9D92FF")
LINE = colors.HexColor("#DDE7E0")
MUTED = colors.HexColor("#71817A")

class BriefDoc(BaseDocTemplate):
    pass

def page(canvas, doc):
    canvas.saveState()
    canvas.setFillColor(PAPER)
    canvas.rect(0, 0, A4[0], A4[1], fill=1, stroke=0)
    canvas.setFillColor(INK)
    canvas.rect(0, A4[1] - 14*mm, A4[0], 14*mm, fill=1, stroke=0)
    canvas.setFillColor(LIME)
    canvas.circle(15*mm, A4[1] - 7*mm, 2.2*mm, fill=1, stroke=0)
    canvas.setFont("STSong-Light", 8.5)
    canvas.setFillColor(colors.white)
    canvas.drawString(21*mm, A4[1] - 9*mm, "晶流 LabFlow  |  AI 实验研发加速器")
    canvas.setFillColor(MUTED)
    canvas.setFont("STSong-Light", 7.5)
    canvas.drawRightString(A4[0] - 16*mm, 9*mm, f"2026 AI 先锋未来人才大赛  |  {doc.page}")
    canvas.restoreState()

def cover_page(canvas, doc):
    canvas.saveState()
    canvas.setFillColor(INK2)
    canvas.rect(0, 0, A4[0], A4[1], fill=1, stroke=0)
    canvas.setFillColor(LIME)
    canvas.circle(29*mm, A4[1]-30*mm, 5*mm, fill=1, stroke=0)
    canvas.setStrokeColor(AQUA)
    canvas.setLineWidth(1)
    canvas.circle(A4[0]-34*mm, 45*mm, 30*mm, fill=0, stroke=1)
    canvas.setStrokeColor(VIOLET)
    canvas.circle(A4[0]-34*mm, 45*mm, 19*mm, fill=0, stroke=1)
    canvas.setFillColor(colors.white)
    canvas.setFont("STSong-Light", 13)
    canvas.drawString(24*mm, A4[1]-53*mm, "2026 AI 先锋未来人才大赛  |  晶泰科技命题")
    canvas.setFont("STSong-Light", 34)
    canvas.drawString(24*mm, A4[1]-87*mm, "晶流 LabFlow")
    canvas.setFillColor(LIME)
    canvas.setFont("STSong-Light", 22)
    canvas.drawString(24*mm, A4[1]-105*mm, "AI 实验研发加速器")
    canvas.setFillColor(colors.HexColor("#AFC2B9"))
    canvas.setFont("STSong-Light", 14)
    canvas.drawString(24*mm, A4[1]-132*mm, "让一次讨论，在 24 小时内成为下一次实验的起点。")
    canvas.setFillColor(colors.HexColor("#80968E"))
    canvas.setFont("STSong-Light", 9.5)
    canvas.drawString(24*mm, 34*mm, "队伍：知识催化剂  |  队长：王浩毅  |  版本：开题报告补充材料 v1.0")
    canvas.restoreState()

styles = getSampleStyleSheet()
styles.add(ParagraphStyle(name="CNTitle", fontName="STSong-Light", fontSize=24, leading=30, textColor=INK, spaceAfter=8*mm))
styles.add(ParagraphStyle(name="CNH2", fontName="STSong-Light", fontSize=15, leading=20, textColor=INK, spaceBefore=4*mm, spaceAfter=3*mm))
styles.add(ParagraphStyle(name="CNBody", fontName="STSong-Light", fontSize=9.5, leading=16, textColor=colors.HexColor("#33453D"), spaceAfter=2.5*mm))
styles.add(ParagraphStyle(name="CNSmall", fontName="STSong-Light", fontSize=8, leading=12, textColor=MUTED))
styles.add(ParagraphStyle(name="CNQuote", fontName="STSong-Light", fontSize=13, leading=21, textColor=INK, backColor=MINT, borderPadding=12, borderRadius=6, spaceAfter=5*mm))
styles.add(ParagraphStyle(name="CNMetric", fontName="STSong-Light", fontSize=20, leading=23, alignment=TA_CENTER, textColor=INK))


def P(text, style="CNBody"):
    return Paragraph(text, styles[style])

def badge(text, color):
    t = Table([[P(text, "CNSmall")]], colWidths=[42*mm])
    t.setStyle(TableStyle([("BACKGROUND",(0,0),(-1,-1),color),("BOX",(0,0),(-1,-1),0,color),("LEFTPADDING",(0,0),(-1,-1),6),("RIGHTPADDING",(0,0),(-1,-1),6),("TOPPADDING",(0,0),(-1,-1),4),("BOTTOMPADDING",(0,0),(-1,-1),4)]))
    return t

frame = Frame(16*mm, 16*mm, A4[0]-32*mm, A4[1]-34*mm, leftPadding=0, rightPadding=0, topPadding=5*mm, bottomPadding=0)
doc = BriefDoc(str(OUT), pagesize=A4, rightMargin=16*mm, leftMargin=16*mm, topMargin=20*mm, bottomMargin=16*mm)
doc.addPageTemplates([PageTemplate(id="cover", frames=frame, onPage=cover_page), PageTemplate(id="body", frames=frame, onPage=page)])

story = [Spacer(1, 230*mm), NextPageTemplate("body"), PageBreak()]
story += [P("01  命题洞察与核心主张", "CNTitle"), P("不是再做一个会议总结工具", "CNQuote")]
story += [P("晶泰科技智能自主实验室每天并行运行大量高通量实验。会议中持续产生参数、方案争议、失败原因和优化结论，但这些内容散落在转写、文档、表格和个人经验里，形成信息、执行、知识与可信四类断点。")]
problems = [
    [badge("01  信息断点", MINT), P("参数和决策依据难以按实验对象检索。")],
    [badge("02  执行断点", AQUA), P("会议结论到负责人、截止时间和实验批次之间依赖人工搬运。")],
    [badge("03  知识断点", colors.HexColor("#EEEAFE")), P("失败案例缺少结构化沉淀，导致相似错误反复发生。")],
    [badge("04  可信断点", colors.HexColor("#FFE7E2")), P("普通大模型总结缺少证据时间戳、置信度、版本与人审状态。")],
]
t = Table(problems, colWidths=[48*mm, 125*mm], rowHeights=[18*mm]*4)
t.setStyle(TableStyle([("VALIGN",(0,0),(-1,-1),"MIDDLE"),("LINEBELOW",(0,0),(-1,-2),.5,LINE),("LEFTPADDING",(0,0),(-1,-1),0),("RIGHTPADDING",(0,0),(-1,-1),4)]))
story += [t, Spacer(1, 5*mm), P("核心指标：24h 知识 SLA", "CNH2"), P("会议结束后 24 小时内，经过确认的关键结论必须带实验编号、证据、适用边界和责任人，能够被有权限的团队成员检索、理解、引用和回溯。")]
metrics = [[P("≥ 90%", "CNMetric"), P("100%", "CNMetric"), P("≥ 60%", "CNMetric"), P("-30%", "CNMetric")],[P("知识 SLA 达标率","CNSmall"),P("证据可追溯率","CNSmall"),P("复用建议采纳率","CNSmall"),P("重复讨论时长目标","CNSmall")]]
mt = Table(metrics, colWidths=[43*mm]*4)
mt.setStyle(TableStyle([("BACKGROUND",(0,0),(-1,-1),colors.white),("BOX",(0,0),(-1,-1),.6,LINE),("INNERGRID",(0,0),(-1,-1),.4,LINE),("ALIGN",(0,0),(-1,-1),"CENTER"),("TOPPADDING",(0,0),(-1,-1),8),("BOTTOMPADDING",(0,0),(-1,-1),8)]))
story += [mt, P("注：以上是首阶段验证目标，不是未经验证的生产成绩。", "CNSmall"), PageBreak()]

story += [P("02  晶流的研发知识闭环", "CNTitle")]
flow = [[P("会前", "CNH2"), P("会中", "CNH2"), P("会后", "CNH2"), P("复用", "CNH2")],
        [P("自动聚合同一实验的参数、历史决策、未关闭风险和相似案例。"),P("识别参数、争议、风险、决策和行动项，保留说话人及时间戳。"),P("人审后联动文档、知识库、多维表和任务，推进实验状态。"),P("下一次相似实验开始前，成功与失败经验主动出现。")]]
ft = Table(flow, colWidths=[43*mm]*4)
ft.setStyle(TableStyle([("BACKGROUND",(0,0),(-1,0),INK),("TEXTCOLOR",(0,0),(-1,0),colors.white),("BACKGROUND",(0,1),(-1,1),colors.white),("BOX",(0,0),(-1,-1),.7,INK),("INNERGRID",(0,0),(-1,-1),.4,LINE),("VALIGN",(0,0),(-1,-1),"TOP"),("LEFTPADDING",(0,0),(-1,-1),8),("RIGHTPADDING",(0,0),(-1,-1),8),("TOPPADDING",(0,0),(-1,-1),8),("BOTTOMPADDING",(0,0),(-1,-1),8)]))
story += [ft, Spacer(1, 5*mm), P("六个产品模块", "CNH2")]
mods = [
    ["研发总览", "24h SLA、闭环率、实验与风险全局可见"], ["会议解析器", "把转写变成带证据的研发对象"],
    ["实验流转", "状态机、负责人、行动项和风险守门"], ["知识湖", "向量召回 + 图谱证据 + 可解释 Rerank"],
    ["失败模式库", "触发参数、症状、根因与避免策略"], ["AI 助理", "解析、相似检索、风险守门三类专用 Agent"]
]
mod_rows=[]
for i in range(0,6,2):
    mod_rows.append([P(f"<b>{mods[i][0]}</b><br/>{mods[i][1]}"),P(f"<b>{mods[i+1][0]}</b><br/>{mods[i+1][1]}")])
modt=Table(mod_rows,colWidths=[86*mm,86*mm],rowHeights=[27*mm]*3)
modt.setStyle(TableStyle([("BACKGROUND",(0,0),(-1,-1),colors.white),("BOX",(0,0),(-1,-1),.5,LINE),("INNERGRID",(0,0),(-1,-1),.5,LINE),("VALIGN",(0,0),(-1,-1),"MIDDLE"),("LEFTPADDING",(0,0),(-1,-1),10)]))
story += [modt, Spacer(1,5*mm), P("差异化不是更多功能，而是三个原则", "CNH2"), P("实验对象驱动，而不是会议文件驱动；成功与失败同等沉淀；所有 AI 结论都有证据、置信度、版本和人审状态。"), PageBreak()]

story += [P("03  技术架构与可信 AI", "CNTitle")]
arch = [
    [P("飞书协同层", "CNH2"), P("会议 AI  /  文档  /  知识库  /  多维表  /  机器人")],
    [P("接入编排层", "CNH2"), P("Spring Gateway  /  Workflow Orchestrator  /  RabbitMQ  /  SSE")],
    [P("Agent 层", "CNH2"), P("会议解析  ->  领域质检  ->  知识关联  ->  任务分派  ->  人审")],
    [P("知识数据层", "CNH2"), P("PostgreSQL + pgvector  /  Neo4j  /  Redis  /  对象存储  /  审计")]
]
at=Table(arch,colWidths=[45*mm,127*mm],rowHeights=[25*mm]*4)
at.setStyle(TableStyle([("BACKGROUND",(0,0),(0,-1),INK2),("TEXTCOLOR",(0,0),(0,-1),colors.white),("BACKGROUND",(1,0),(1,-1),colors.white),("BOX",(0,0),(-1,-1),.7,INK),("INNERGRID",(0,0),(-1,-1),.5,LINE),("VALIGN",(0,0),(-1,-1),"MIDDLE"),("LEFTPADDING",(0,0),(-1,-1),10)]))
story += [at, Spacer(1, 5*mm), P("可靠性设计", "CNH2"), P("事件幂等键与 Outbox 保证重复事件安全；每个 Agent 阶段落 Checkpoint；模型首字节超时自动降级；Structured Output 校验失败进入修复或人工；写入飞书前检查对象版本；死信队列保留失败事件并可重放；trace_id 贯穿转写、模型、审核和知识写入。")]
story += [P("隐私与安全", "CNH2"), P("继承飞书组织与对象权限，检索结果按身份二次过滤；字段级脱敏；向量库保留 tenant、resource、permission 标签；会议文本视为不可信内容，工具调用采用白名单、参数校验和人审；敏感操作全链路审计并支持撤回和删除。")]
story += [P("为什么同时使用 pgvector 与 Neo4j？", "CNH2"), P("pgvector 找到语义候选，Neo4j 校验实验、版本、参数、权限和证据关系。两者结合才能回答‘为什么可复用、适用边界是什么、原始证据在哪里’，避免仅凭文本相似给出不可靠建议。"), PageBreak()]

story += [P("04  已完成的可运行验证版", "CNTitle"), P("不是只做概念图：当前仓库包含真实 Node.js API、响应式前端、脱敏种子数据、会议解析、任务创建和统一检索，可离线运行。", "CNQuote")]
if SCREENSHOT.exists():
    img = Image(str(SCREENSHOT), width=173*mm, height=132*mm)
    story += [img, Spacer(1, 3*mm)]
story += [P("六个工作台：研发总览、实验流转、知识湖、AI 助理、连接器、偏好设置。主链路：选择 B-17 参数评审会议 -> 结构化提炼决策/风险/知识关联 -> 显示证据时间戳 -> 拆解行动项 -> 写入知识闭环。", "CNBody"), P("诚实边界", "CNH2"), P("由于没有赛事租户和企业数据授权，当前飞书连接器按正式接口契约设计，演示环境使用确定性 AI 适配器。页面效率数值属于演示数据或验证目标，不表述为晶泰生产环境实际结果。"), PageBreak()]

story += [P("05  实施计划、团队与价值", "CNTitle")]
roadmap = [[P("W1", "CNH2"), P("企业教练访谈、流程/字段/权限确认、5 场脱敏样本")], [P("W2", "CNH2"), P("会议解析、Structured Output、人审、文档与多维表黄金主链路")], [P("W3", "CNH2"), P("失败模式、知识图谱、向量检索、Rerank 与风险守门")], [P("W4", "CNH2"), P("双人标注评测、异常链路测试、演示视频和路演打磨")]]
rt=Table(roadmap,colWidths=[25*mm,147*mm],rowHeights=[22*mm]*4)
rt.setStyle(TableStyle([("BACKGROUND",(0,0),(0,-1),LIME),("BOX",(0,0),(-1,-1),.6,LINE),("INNERGRID",(0,0),(-1,-1),.4,LINE),("VALIGN",(0,0),(-1,-1),"MIDDLE"),("LEFTPADDING",(0,0),(-1,-1),10)]))
story += [rt, Spacer(1,5*mm), P("团队能力", "CNH2"), P("队长王浩毅：中国地质大学（武汉）GIS 硕士在读，求职方向 Java 后端 / AI 应用开发。具备 Spring Cloud、Spring AI、RAG、pgvector、Neo4j、LangGraph、Redis、RabbitMQ 和 Docker 工程经验；硕士研究方向为大语言模型驱动的企业知识图谱自动化构建与隐私保护。")]
team = [[P("王浩毅  |  产品与技术负责人", "CNH2"), P("后端、Agent、知识图谱、接口、部署与技术答辩")], [P("队员 2  |  协同体验与验证", "CNH2"), P("飞书工作流、样本标注、UI/视频、业务答辩与可用性测试")]]
tt=Table(team,colWidths=[75*mm,97*mm],rowHeights=[25*mm]*2)
tt.setStyle(TableStyle([("BACKGROUND",(0,0),(-1,-1),colors.white),("BOX",(0,0),(-1,-1),.6,LINE),("INNERGRID",(0,0),(-1,-1),.4,LINE),("VALIGN",(0,0),(-1,-1),"MIDDLE"),("LEFTPADDING",(0,0),(-1,-1),10)]))
story += [tt, Spacer(1,6*mm), P("让每一次判断留下证据，让每一次失败成为下一次发现的捷径。", "CNQuote"), P("官方依据：activity.feishu.cn/future-talent  |  晶泰科技命题详情  |  赛事热度榜动态页。完整代码、文档、素材来源和验收截图均已保存在参赛工作目录。", "CNSmall")]

doc.build(story)
print(OUT)

